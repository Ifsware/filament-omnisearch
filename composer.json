{
    "name": "ifsware/ifsware-spotlight",
    "description": "Powerful dynamic spotlight search plugin for Filament",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ifsware",
            "email": "dev@ifsware.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0|^10.0",
        "larastan/larastan": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Ifsware\\Spotlight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ifsware\\Spotlight\\": "src/",
            "Ifsware\\Spotlight\\Workbench\\": "workbench/",
            "Ifsware\\Spotlight\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "serve": "php -S localhost:8000 -t vendor/orchestra/testbench-core/laravel/public"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ifsware\\Spotlight\\IfswareSpotlightServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
